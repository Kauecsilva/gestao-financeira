# Sem estas variáveis o app roda em modo local (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Assistente: por padrão é a calculadora gratuita do app. Para usar o Claude (pago por pergunta),
# defina NEXT_PUBLIC_ASSISTANT_MODE=ai e a chave abaixo (fica só no servidor).
NEXT_PUBLIC_ASSISTANT_MODE=
ANTHROPIC_API_KEY=
# Em produção sem Supabase o assistente fica bloqueado; "true" libera sem login (não recomendado).
ASSISTANT_ALLOW_ANONYMOUS=

# Bancos conectados (Open Finance via Pluggy). Chaves do app em dashboard.pluggy.ai; ficam só no servidor.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
